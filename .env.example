# Copy to .env and set values locally. NEVER commit .env or real keys.
# Backend (optional for AI / market data)
OPENAI_API_KEY=
ALPHAVANTAGE_API_KEY=

# Docker Compose Postgres (local dev only; use strong passwords in production)
POSTGRES_DB=traderplanner
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader

# Backend DB connection (local dev defaults; override in production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traderplanner
DB_USER=trader
DB_PASSWORD=trader

