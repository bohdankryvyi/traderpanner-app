#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper startup script
# ----------------------------------------------------------------------------

if [ -z "$MAVEN_WRAPPER_LAUNCHER" ]; then
  MAVEN_WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain
fi

WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES=".mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper jar..."
  mkdir -p ".mvn/wrapper"
  MAVEN_WRAPPER_VERSION=3.3.2
  WRAPPER_JAR_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/$MAVEN_WRAPPER_VERSION/maven-wrapper-$MAVEN_WRAPPER_VERSION.jar"
  curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_JAR_URL" || wget -O "$WRAPPER_JAR" "$WRAPPER_JAR_URL"
fi

JAVA_EXEC="java"

exec "$JAVA_EXEC" \
  -cp "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=." \
  "-Dmaven.wrapper.properties=$WRAPPER_PROPERTIES" \
  $MAVEN_WRAPPER_LAUNCHER "$@"

