{
  "name": "traderpanner-e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "eslint tests src playwright.config.ts globalSetup.ts",
    "format": "prettier --write \"tests/**/*.ts\" \"src/**/*.ts\" playwright.config.ts globalSetup.ts",
    "format:check": "prettier --check \"tests/**/*.ts\" \"src/**/*.ts\" playwright.config.ts globalSetup.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  },
  "description": "Minimal E2E suite for Trading and Portfolio CRUD flows. Tests use the UI to create, edit, and delete records, then verify via backend API that the list is empty.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "playwright": "^1.58.2",
    "playwright-core": "^1.58.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
